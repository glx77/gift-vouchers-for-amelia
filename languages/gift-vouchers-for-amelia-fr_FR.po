#: includes/class-gvfa-admin.php:152
msgid "Printable voucher"
msgstr "Bon imprimable"

#: includes/class-gvfa-admin.php:154
msgid "Attach a printable gift voucher (image) to the buyer email."
msgstr "Joindre un bon cadeau imprimable (image) à l’e-mail de l’acheteur."

